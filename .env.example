NODE_ENV=development
LISTEN_HOST=127.0.0.1
PORT=3012
PUBLIC_BASE_URL=http://127.0.0.1:3012
LOG_LEVEL=info
WITNESS_NETWORK=regtest
WITNESS_SOURCE_REVISION=

INDEXER_ENABLED=true
INDEXER_START_HEIGHT=0
INDEXER_BLOCK_POLL_MS=10000
INDEXER_MEMPOOL_POLL_MS=15000
INDEXER_CONFIRMATIONS=6
INDEXER_LEASE_TTL_MS=30000
INDEXER_LEASE_RENEW_MS=10000
INDEXER_INSTANCE_ID=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=witness_circles
MYSQL_USER=witness
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10
MYSQL_SSL=false

BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=
BITCOIN_RPC_TIMEOUT_MS=30000
BITCOIN_ZMQ_HASHBLOCK=tcp://127.0.0.1:28332
BITCOIN_ZMQ_RAWTX=tcp://127.0.0.1:28333
BITCOIN_ZMQ_SEQUENCE=tcp://127.0.0.1:28334

ADMIN_API_KEYS=
PUBLIC_RATE_LIMIT_TTL_MS=60000
PUBLIC_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_MAX=10
CORS_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
WEBSOCKET_MAX_CONNECTIONS=1000
WEBSOCKET_MAX_CONNECTIONS_PER_IP=50
WEBSOCKET_RATE_LIMIT_WINDOW_MS=10000
WEBSOCKET_RATE_LIMIT_MAX=100
WEBSOCKET_MAX_MESSAGE_BYTES=16384
WEBSOCKET_MAX_ROOMS_PER_CONNECTION=32
